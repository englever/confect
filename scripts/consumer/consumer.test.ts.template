import { TestConfect } from "@confect/test";
import * as Effect from "effect/Effect";
import { expect, test } from "vitest";
import convexSchema from "./confect/_generated/convexSchema";
import refs from "./confect/_generated/refs";
import databaseSchema from "./confect/_generated/schema";

const Test = TestConfect.TestConfect<typeof databaseSchema>();
const layer = TestConfect.layer(
  databaseSchema,
  convexSchema,
  import.meta.glob("./convex/**/*.ts"),
);

test("installed fork executes a generated query with TestConfect", async () => {
  const result = await Effect.runPromise(
    Effect.gen(function* () {
      const confect = yield* Test;
      return yield* confect.query(refs.public.hello.greet);
    }).pipe(Effect.provide(layer)),
  );
  expect(result).toBe("hello from fork");
});
